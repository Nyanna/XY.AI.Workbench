{
{% for c in constants %}
    case {{ c.constant_name }};
{% endfor %}

    public function rawValue(): {{ raw_type }}
    {
        return match ($this) {
{% for c in constants %}
            self::{{ c.constant_name }} => {{ c.literal }},
{% endfor %}
        };
    }

    public static function fromValue({{ raw_type }} $value): self
